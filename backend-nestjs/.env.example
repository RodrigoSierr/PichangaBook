# ============================================================================
# PichangaBook Arequipa — Variables de Entorno (.env.example)
# Copia este archivo a .env y completa las credenciales reales o de Sandbox.
# ============================================================================

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# --- Seguridad JWT y Firma Temporal de Documentos Privados ---
JWT_SECRET=reemplazar-por-secreto-de-256-bits-en-produccion
JWT_EXPIRES_IN=7d
MEDIA_SIGNING_SECRET=reemplazar-por-secreto-hmac-multimedia

# --- Modo de Respaldo Local (false por defecto; activar true solo en demo local) ---
ALLOW_DEMO_FALLBACK=false
DEMO_SEED_DATA=false
DEMO_AUTO_VERIFY_SECONDS=0

# --- Base de Datos PostgreSQL (si está vacío usa PGlite WASM embebido en no-producción) ---
DATABASE_URL=
DATABASE_SSL=false
DB_AUTO_MIGRATE=true
PGLITE_DATA_DIR=

# --- Autenticación (SMS_GATEWAY | FIREBASE | SUPABASE | DEMO) ---
AUTH_PROVIDER=SMS_GATEWAY
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PUBLIC_KEY_PEM=

# --- Pasarela de Pagos Culqi (Tarjetas, Yape, Plin) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=reemplazar-por-secreto-webhook-culqi

# --- Multimedia (Cloudinary para clips de suplentes 15-30s) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Geolocalización (Google Maps Platform) ---
GOOGLE_MAPS_API_KEY=
