# ============================================================================
# PichangaBook Arequipa — Variables de Entorno (.env.example)
# Copia este archivo a .env y completa las credenciales reales o de Sandbox.
# ============================================================================

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# --- CORS y Orígenes Permitidos (separados por coma en producción) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Seguridad JWT y Firma Temporal de Documentos Privados ---
JWT_SECRET=reemplazar-por-secreto-de-256-bits-en-produccion
JWT_EXPIRES_IN=7d
MEDIA_SIGNING_SECRET=reemplazar-por-secreto-hmac-multimedia

# --- Modo de Respaldo Local (false por defecto; activar true solo en demo local) ---
ALLOW_DEMO_FALLBACK=false
DEMO_MODE=false
DB_SEED_DEMO=false
DEMO_AUTO_VERIFY_SECONDS=0

# --- Base de Datos PostgreSQL (si está vacío usa PGlite WASM embebido en no-producción) ---
# Nota: SSL se activa automáticamente si DATABASE_URL incluye sslmode=require, neon.tech, supabase.co o render.com
DATABASE_URL=
DB_SSL=false
DATABASE_SSL=false
DB_AUTO_MIGRATE=true
PGLITE_DATA_DIR=

# --- Autenticación (FIREBASE | SUPABASE | DEMO [solo en desarrollo]) ---
AUTH_PROVIDER=FIREBASE
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PUBLIC_KEY=
FIREBASE_PRIVATE_KEY=

# --- Alternativa Auth: Supabase ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# --- Proveedor SMS HTTP para OTP en Producción (Twilio / Webhook HTTP) ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=PichangaBook

# --- Pasarela de Pagos Culqi (Tarjetas, Yape, Plin) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=reemplazar-por-secreto-webhook-culqi

# --- Pasarela Alternativa: MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=

# --- Multimedia (Cloudinary para clips de suplentes 15-30s) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Geolocalización (Google Maps Platform) ---
GOOGLE_MAPS_API_KEY=
