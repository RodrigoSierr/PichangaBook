# =============================================================================
#  PichangaBook Arequipa · Variables de entorno del backend
#  Copiar a .env y completar. Sin credenciales, todo corre en MODO DEMO
#  (PostgreSQL embebido + integraciones simuladas) para la presentación.
# =============================================================================

PORT=3000
PUBLIC_URL=http://localhost:3000
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=7d

# --- Base de datos ----------------------------------------------------------
# Si DATABASE_URL está vacío se usa PostgreSQL embebido (PGlite, WASM) en memoria
# con el mismo schema.sql + seed.sql. Con Docker:
# DATABASE_URL=postgres://pichanga:pichanga@localhost:5432/pichangabook
DATABASE_URL=
DATABASE_SSL=false
# Ejecuta schema.sql + seed.sql si la BD está vacía
DB_AUTO_MIGRATE=true
# Carpeta para persistir PGlite entre reinicios (vacío = en memoria, se resetea)
PGLITE_DATA_DIR=

# --- Autenticación OTP (SMS) -------------------------------------------------
# DEMO | FIREBASE | SUPABASE
AUTH_PROVIDER=DEMO
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Google Maps Platform (Maps JS/SDK, Places, Geocoding) ------------------
GOOGLE_MAPS_API_KEY=

# --- Multimedia: Cloudinary (clips 15-30 s) / AWS S3 -------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# --- Pagos: Culqi (tarjeta, Yape) / Mercado Pago -----------------------------
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=pichangabook-webhook-demo
MERCADOPAGO_ACCESS_TOKEN=

# --- Demo ---------------------------------------------------------------------
# Simula la aprobación del backoffice tras subir el RUC/licencia (segundos)
DEMO_AUTO_VERIFY_SECONDS=8
